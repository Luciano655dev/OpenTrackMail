{
  "name": "@opentrackmail/extension",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src vite.config.ts manifest.config.ts",
    "test": "vitest run",
    "package": "npm run build && cd dist && zip -r ../opentrackmail-extension.zip ."
  },
  "dependencies": {
    "@opentrackmail/shared": "*"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.1.6",
    "@types/node": "^24.3.1",
    "eslint": "^9.35.0",
    "jsdom": "26.1.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vite": "^7.1.5",
    "vitest": "5.0.0"
  }
}
