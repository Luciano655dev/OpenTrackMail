# Public browser configuration. Row Level Security protects user data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Optional Google Search Console HTML-tag verification token.
GOOGLE_SITE_VERIFICATION=

# Server-only configuration. Never expose these values to the extension.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
EVENT_HASH_SECRET=replace-with-at-least-32-random-bytes
TRACKING_PIXEL_ORIGIN=http://localhost:3001

# Comma-separated production extension origins. Empty is allowed in development.
ALLOWED_EXTENSION_ORIGINS=
