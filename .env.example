# Public Supabase project settings. Safe for browser use; RLS still protects data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Unified public site origin. Marketing is at / and the signed-in app is at /app.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Browser-only UI testing can use localhost. Real recipient testing requires the
# public HTTPS URL printed by `cloudflared --config /dev/null tunnel --url http://localhost:3001`.
TRACKING_PIXEL_ORIGIN=https://your-temporary-tunnel.trycloudflare.com

# Server-only. Never put this in the extension or NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional production-only controls.
# Comma-separated extension origins after the Chrome Web Store ID is known.
ALLOWED_EXTENSION_ORIGINS=chrome-extension://your-extension-id
# Secret used to hash request metadata for short-window duplicate grouping.
EVENT_HASH_SECRET=replace-with-at-least-32-random-bytes

# Chrome extension build-time configuration. For recipient open testing, use
# the same public HTTPS tunnel as TRACKING_PIXEL_ORIGIN, then rebuild/reload.
VITE_API_URL=https://your-temporary-tunnel.trycloudflare.com
VITE_APP_URL=http://localhost:3001/app
VITE_SUPABASE_URL=https://your-project.supabase.co
